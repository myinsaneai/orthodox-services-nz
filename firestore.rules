rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // ── Roles ────────────────────────────────────────────────────────────────
    // A person's role is users/{uid}.role: user, coordinator, admin or superadmin
    // (the same table as src/lib/roles.ts). Until a person has a profile, the old
    // admins/{uid} record of a superadmin still counts, so nobody is locked out
    // while moving over; their profile is created at their next sign-in.
    function myProfile() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return exists(myProfile()); }
    function legacySuper() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }
    function profileRoleIn(roles) {
      return hasProfile() && get(myProfile()).data.role in roles;
    }
    function isSuperAdmin() {
      return isSignedIn() && (profileRoleIn(['superadmin']) || (!hasProfile() && legacySuper()));
    }
    function isAdminUp() {
      return isSignedIn() && (profileRoleIn(['admin', 'superadmin']) || (!hasProfile() && legacySuper()));
    }
    function isCoordinator() { return isSignedIn() && profileRoleIn(['coordinator']); }

    // Admins and superadmins may edit every parish; a coordinator only the parishes
    // listed on their own profile.
    function canEditParish(parishId) {
      return isAdminUp() ||
        (isCoordinator() && get(myProfile()).data.parishIds is list &&
         parishId in get(myProfile()).data.parishIds);
    }

    // Parishes: public read. An admin or superadmin adds, edits and deletes parishes (shape checked
    // on every write; the slug, which links and the document name rely on, never changes).
    function reqStr(f, min, max) {
      return request.resource.data.get(f, null) is string &&
             request.resource.data.get(f, '').size() >= min && request.resource.data.get(f, '').size() <= max;
    }
    function optStr(f, max) {
      return request.resource.data.get(f, '') is string && request.resource.data.get(f, '').size() <= max;
    }
    function parishOk(id) {
      return request.resource.data.keys().hasOnly(
               ['slug', 'nameEn', 'nameEl', 'state', 'city', 'cityEl', 'address', 'descriptionEn', 'descriptionEl',
                'mapUrl', 'photoURL', 'groupIds', 'accentColor', 'order', 'visible'])
          && request.resource.data.keys().hasAll(
               ['slug', 'nameEn', 'nameEl', 'state', 'city', 'cityEl', 'address', 'groupIds', 'accentColor', 'order', 'visible'])
          && request.resource.data.slug == id
          && reqStr('nameEn', 1, 120) && reqStr('nameEl', 1, 120)
          && reqStr('city', 1, 80) && reqStr('cityEl', 1, 80)
          && reqStr('state', 1, 20)
          && reqStr('address', 1, 500) && optStr('descriptionEn', 2000) && optStr('descriptionEl', 2000)
          && optStr('accentColor', 20)
          && optStr('mapUrl', 500)
          && (request.resource.data.get('mapUrl', '') == '' ||
              request.resource.data.get('mapUrl', '').matches(
                'https://(www[.])?google[.]([a-z]+[.])?[a-z]+/maps.*|https://maps[.]google[.]([a-z]+[.])?[a-z]+/.*|https://maps[.]app[.]goo[.]gl/.*|https://goo[.]gl/maps/.*'))
          && optStr('photoURL', 2000)
          && (request.resource.data.get('photoURL', '') == '' ||
              request.resource.data.get('photoURL', '').matches('https://firebasestorage[.]googleapis[.]com/.*'))
          && request.resource.data.groupIds is list && request.resource.data.groupIds.size() <= 50
          && request.resource.data.order is number
          && request.resource.data.visible is bool;
    }
    match /parishes/{id} {
      allow read: if true;
      allow create: if isAdminUp() && parishOk(id) && request.resource.data.groupIds == [];
      // Moving a parish up or down changes only `order`; that is allowed on any existing record and needs nothing
      // else from the stored document (an older record may lack fields the form now requires, even `slug`).
      // Every other change is a full edit: the slug stays, and the whole record must pass parishOk.
      // The order-only test comes first so parishOk (which raises an error, rather than returning false, on a
      // record missing a field) is never evaluated for a move.
      allow update: if isAdminUp()
                    && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['order'])
                         && request.resource.data.order is number)
                        || (resource.data.slug == request.resource.data.slug && parishOk(id)));
      allow delete: if isAdminUp();
    }
    // Public read; superadmin write (groups, site settings).
    match /groups/{id}    { allow read: if true; allow write: if isSuperAdmin(); }
    match /settings/{id}  { allow read: if true; allow write: if isSuperAdmin(); }

    // Service days: what a parish posts for one day, as free text in English and Greek, in the document
    // `<parishId>_<YYYY-MM-DD>`. Public read. An admin or superadmin writes any parish's days; a coordinator
    // only the parishes on their own profile (canEditParish). The shape is checked on every write and the
    // parish and date of an existing day can never change (the document name depends on them).
    function dayOk(id) {
      return request.resource.data.keys().hasOnly(['parishId', 'date', 'yearMonth', 'entriesEn', 'entriesEl', 'updatedAt'])
          && request.resource.data.keys().hasAll(['parishId', 'date', 'yearMonth', 'entriesEn', 'entriesEl', 'updatedAt'])
          && request.resource.data.parishId is string
          && request.resource.data.parishId.size() >= 1 && request.resource.data.parishId.size() <= 100
          && request.resource.data.date is string
          && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.yearMonth ==
             request.resource.data.date.split('-')[0] + '-' + request.resource.data.date.split('-')[1]
          && id == request.resource.data.parishId + '_' + request.resource.data.date
          && request.resource.data.entriesEn is string && request.resource.data.entriesEn.size() <= 4000
          && request.resource.data.entriesEl is string && request.resource.data.entriesEl.size() <= 4000
          && request.resource.data.updatedAt == request.time;
    }
    match /serviceDays/{id} {
      allow read: if true;
      allow create: if dayOk(id) && canEditParish(request.resource.data.parishId);
      allow update: if dayOk(id)
                    && request.resource.data.parishId == resource.data.parishId
                    && request.resource.data.date == resource.data.date
                    && canEditParish(resource.data.parishId);
      allow delete: if canEditParish(resource.data.parishId);
    }

    // Templates (a saved full day) and quick entries (a saved line) for the schedule editor: the same for
    // every parish. Coordinators and up read them to use them; only admins and superadmins change them.
    match /serviceTemplates/{id} {
      allow read: if isCoordinator() || isAdminUp();
      allow create, update: if isAdminUp()
        && request.resource.data.keys().hasOnly(['nameEn', 'nameEl', 'entriesEn', 'entriesEl', 'order'])
        && request.resource.data.keys().hasAll(['nameEn', 'nameEl', 'entriesEn', 'entriesEl', 'order'])
        && reqStr('nameEn', 1, 100) && reqStr('nameEl', 1, 100)
        && optStr('entriesEn', 4000) && optStr('entriesEl', 4000)
        && request.resource.data.order is number;
      allow delete: if isAdminUp();
    }
    match /serviceEntryTypes/{id} {
      allow read: if isCoordinator() || isAdminUp();
      allow create, update: if isAdminUp()
        && request.resource.data.keys().hasOnly(['textEn', 'textEl', 'order'])
        && request.resource.data.keys().hasAll(['textEn', 'textEl', 'order'])
        && reqStr('textEn', 1, 200) && reqStr('textEl', 1, 200)
        && request.resource.data.order is number;
      allow delete: if isAdminUp();
    }

    // ── User profiles ───────────────────────────────────────────────────────
    function newKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function textOk(field, max) {
      return request.resource.data.get(field, '') is string &&
             request.resource.data.get(field, '').size() <= max;
    }
    // A photo address must be empty, a Google account picture or our own Firebase Storage
    // (the same pattern as src/lib/photoUrl.ts; a test keeps them identical).
    function photoUrlOk() {
      return request.resource.data.get('photoURL', '') is string &&
             (request.resource.data.get('photoURL', '') == '' ||
              request.resource.data.get('photoURL', '').matches(
                'https://([a-z0-9-]+[.])+googleusercontent[.]com/.*|https://firebasestorage[.]googleapis[.]com/.*'));
    }
    function emailOk() {
      return request.resource.data.email is string &&
             request.resource.data.email == request.auth.token.get('email', '');
    }

    // How the person signs in: only these two values, at most once each (nothing else is trusted from it).
    function providersOk() {
      return request.resource.data.get('providers', []) is list &&
             request.resource.data.get('providers', []).size() <= 2 &&
             request.resource.data.get('providers', []).hasOnly(['google', 'password']);
    }

    // First sign-in: a person creates their own profile as a plain user. The old
    // admins/{uid} superadmin must create it as superadmin (so they are not demoted by accident).
    function newProfileOk() {
      return request.resource.data.keys().hasOnly(
               ['uid', 'email', 'displayName', 'photoURL', 'providers', 'role', 'parishIds', 'createdAt', 'lastSignInAt'])
          && request.resource.data.keys().hasAll(['uid', 'email', 'role', 'parishIds', 'createdAt', 'lastSignInAt'])
          && request.resource.data.uid == request.auth.uid
          && emailOk() && textOk('displayName', 200) && textOk('photoURL', 2000) && photoUrlOk() && providersOk()
          && request.resource.data.parishIds == []
          && request.resource.data.createdAt == request.time
          && request.resource.data.lastSignInAt == request.time
          && ((request.resource.data.role == 'user' && !legacySuper()) ||
              (request.resource.data.role == 'superadmin' && legacySuper()));
    }

    // A person may edit their own name and photo and refresh email, sign-in method and last-sign-in
    // time, never their role.
    function selfEditOk() {
      return newKeys().hasOnly(['displayName', 'photoURL', 'email', 'providers', 'profileEdited', 'lastSignInAt'])
          && textOk('displayName', 200) && textOk('photoURL', 2000) && providersOk()
          && (!newKeys().hasAny(['photoURL']) || photoUrlOk())
          && (!newKeys().hasAny(['profileEdited']) || request.resource.data.profileEdited == true)
          && (!newKeys().hasAny(['email']) || emailOk())
          && (!newKeys().hasAny(['lastSignInAt']) || request.resource.data.lastSignInAt == request.time);
    }

    // Changing someone else's role (never your own):
    //   superadmin  any person, any role
    //   admin       only people who are now user or coordinator, to user / coordinator / admin
    function roleChangeOk() {
      return newKeys().hasOnly(['role', 'parishIds'])
          && request.resource.data.role in ['user', 'coordinator', 'admin', 'superadmin']
          && request.resource.data.parishIds is list
          && request.resource.data.parishIds.size() <= 500
          && (request.resource.data.role == 'coordinator' || request.resource.data.parishIds.size() == 0)
          && (isSuperAdmin() ||
              (isAdminUp() &&
               resource.data.role in ['user', 'coordinator'] &&
               request.resource.data.role in ['user', 'coordinator', 'admin']));
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdminUp());
      allow create: if isSignedIn() && request.auth.uid == uid && newProfileOk();
      allow update: if isSignedIn() &&
                       ((request.auth.uid == uid && selfEditOk()) ||
                        (request.auth.uid != uid && roleChangeOk()));
      // Removes the profile only (the sign-in account stays); superadmin, never themselves.
      allow delete: if isSuperAdmin() && request.auth.uid != uid;
    }

    // Retired: the first superadmin's record. Read only, so the profile can be created from it.
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if false;
    }
  }
}

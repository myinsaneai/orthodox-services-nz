rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isSuperAdmin() { return isAdmin() && adminDoc().role == 'superadmin'; }
    // Parish-admin may edit only the parishes listed in their admins doc.
    function canEditParish(parishId) {
      return isSuperAdmin() ||
        (isAdmin() && adminDoc().role == 'parish-admin' &&
         adminDoc().parishIds is list && parishId in adminDoc().parishIds);
    }

    // Public read; superadmin write (parish list, groups, site settings).
    match /parishes/{id}  { allow read: if true; allow write: if isSuperAdmin(); }
    match /groups/{id}    { allow read: if true; allow write: if isSuperAdmin(); }
    match /settings/{id}  { allow read: if true; allow write: if isSuperAdmin(); }

    // Services: public read; write only for the parish the service belongs to.
    match /services/{id} {
      allow read: if true;
      allow create: if canEditParish(request.resource.data.parishId);
      allow update: if canEditParish(resource.data.parishId)
                    && canEditParish(request.resource.data.parishId);
      allow delete: if canEditParish(resource.data.parishId);
    }

    // Admin records: a user may read their own; only superadmin manages them.
    match /admins/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }
  }
}
